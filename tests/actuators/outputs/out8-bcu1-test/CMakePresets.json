{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "default-build-directory",
            "description": "Sets the build directory",
            "hidden": true,
            "binaryDir": "${sourceDir}/cmake-build/${presetName}"
        },
        {
            "name": "default-generator-ninja-multi-config",
            "description": "Sets the Ninja Multi Config generator",
            "hidden": true,
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "x64",
            "displayName": "x64 Host Test",
            "description": "Host test for x64, the architecture used by the CI of the sblib host tests",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x64"
            }
        },
        {
            "name": "x86",
            "displayName": "x86 Host Test",
            "description": "Host test for x86, as the MCUXpresso project (-m32). Needs a multilib host compiler",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x86"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-x64",
            "configurePreset": "x64",
            "configuration": "Debug",
            "displayName": "x64 Host Test Debug Build",
            "description": "Build the x64 host test in Debug configuration",
            "hidden": false,
            "targets": [
                "out8-bcu1-test_x64"
            ]
        },
        {
            "name": "release-x64",
            "configurePreset": "x64",
            "configuration": "Release",
            "displayName": "x64 Host Test Release Build",
            "description": "Build the x64 host test in Release configuration",
            "hidden": false,
            "targets": [
                "out8-bcu1-test_x64"
            ]
        },
        {
            "name": "debug-x86",
            "configurePreset": "x86",
            "configuration": "Debug",
            "displayName": "x86 Host Test Debug Build",
            "description": "Build the x86 host test in Debug configuration",
            "hidden": false,
            "targets": [
                "out8-bcu1-test_x86"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test-debug-x64",
            "configurePreset": "x64",
            "configuration": "Debug",
            "displayName": "x64 Host Test Debug Test",
            "description": "Run the x64 host test in Debug configuration",
            "hidden": false,
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-release-x64",
            "configurePreset": "x64",
            "configuration": "Release",
            "displayName": "x64 Host Test Release Test",
            "description": "Run the x64 host test in Release configuration",
            "hidden": false,
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
