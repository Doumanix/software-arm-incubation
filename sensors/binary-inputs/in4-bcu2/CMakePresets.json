{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "default-build-directory",
            "description": "Sets the build directory",
            "hidden": true,
            "binaryDir": "${sourceDir}/cmake-build/${presetName}"
        },
        {
            "name": "default-generator-ninja-multi-config",
            "description": "Sets the Ninja Multi Config generator",
            "hidden": true,
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "default-toolchain-arm-none-eabi",
            "description": "Sets Toolchain arm-none-eabi (using MCUXpresso)",
            "hidden": true,
            "toolchainFile": "${sourceDir}/../../../software-arm-lib/cmake/toolchains/arm-none-eabi_mcuxpresso.cmake"
        },
        {
            "name": "arm",
            "displayName": "ARM Target",
            "description": "Sets Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja Multi Config generator",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config",
                "default-toolchain-arm-none-eabi"
            ]
        },
        {
            "name": "rp2350-pico2",
            "displayName": "RP2350 Target (Pico 2 test board)",
            "description": "RP2350 build with external Pico SDK 2.2.0 from PICO_SDK_PATH, toolchain from ARM_TOOLCHAIN_PATH or MCUXPRESSO_TOOLCHAIN_PATH",
            "hidden": false,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja-multi-config"
            ],
            "cacheVariables": {
                "PICO_SDK_PATH": "$env{PICO_SDK_PATH}",
                "SBLIB_MCU": "RP2350",
                "SBLIB_BOARD": "pico2_testboard",
                "PICO_PLATFORM": "rp2350-arm-s",
                "PICO_BOARD": "pico2"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-arm",
            "configurePreset": "arm",
            "configuration": "Debug",
            "displayName": "ARM Target Debug Build",
            "hidden": false,
            "targets": [
                "in4-bcu2_all"
            ]
        },
        {
            "name": "release-arm",
            "configurePreset": "arm",
            "configuration": "Release",
            "displayName": "ARM Target Release Build",
            "hidden": false,
            "targets": [
                "in4-bcu2_all"
            ]
        },
        {
            "name": "debug-rp2350-pico2",
            "configurePreset": "rp2350-pico2",
            "configuration": "Debug",
            "displayName": "RP2350 Debug Build",
            "hidden": false,
            "targets": [
                "in4-bcu2_all"
            ]
        },
        {
            "name": "release-rp2350-pico2",
            "configurePreset": "rp2350-pico2",
            "configuration": "Release",
            "displayName": "RP2350 Release Build",
            "hidden": false,
            "targets": [
                "in4-bcu2_all"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "build-arm-all",
            "description": "Build in4-bcu2 in Debug and Release configurations",
            "displayName": "Build ARM (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm"
                },
                {
                    "type": "build",
                    "name": "release-arm"
                },
                {
                    "type": "build",
                    "name": "debug-arm"
                }
            ]
        },
        {
            "name": "build-rp2350-pico2-all",
            "description": "Build in4-bcu2 for the RP2350 in Debug and Release configurations",
            "displayName": "Build RP2350 Pico 2 (all configs)",
            "steps": [
                {
                    "type": "configure",
                    "name": "rp2350-pico2"
                },
                {
                    "type": "build",
                    "name": "release-rp2350-pico2"
                },
                {
                    "type": "build",
                    "name": "debug-rp2350-pico2"
                }
            ]
        }
    ]
}
